# Maintainer: Adrian <adrian@mxlinux.org>

# PKGBUILD for building on the Open Build Service.
#
# OBS build VMs have no network, so every source has to be present in the
# package's OBS sources before the build starts. This consumes the Debian
# native tarball that release builds commit to debs/ - it carries the complete
# source tree - instead of fetching a GitHub tarball the way aur/PKGBUILD does.
#
# Keep pkgver in step with debian/changelog: it names the tarball.

# The repository is mx-bootrepair but the package has always been called
# mx-boot-repair, which is also the name in AUR - keep it, so this supersedes
# the AUR package rather than installing alongside it.
pkgname=mx-boot-repair
pkgver=26.07
pkgrel=1
pkgdesc="GUI tool for repairing GRUB bootloader"
arch=('x86_64')
url="https://mxlinux.org"
license=('GPL3')
# grub supplies grub-install, grub-mkconfig and update-grub, which the helper
# runs and refuses to work without; efibootmgr is for the EFI boot entries.
depends=('qt6-base' 'polkit' 'grub' 'efibootmgr')
makedepends=('cmake' 'ninja' 'qt6-tools')
optdepends=('xdg-utils: help display')
# Named for the repository, not for pkgname.
_tarname=mx-bootrepair
source=("${_tarname}_${pkgver}.tar.xz")
sha256sums=('SKIP')

# dpkg-source packed this tarball from a directory called "src", so that - not
# ${pkgname}-${pkgver} - is what it unpacks to.
_srcdir="src"

build() {
    cd "${srcdir}/${_srcdir}"

    # HELPER_INSTALL_DIR is baked into both the binary and the generated polkit
    # policy, so package() must install the helper exactly where this says.
    cmake -G Ninja \
        -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DHELPER_INSTALL_DIR=/usr/lib/mx-boot-repair \
        -DPROJECT_VERSION_OVERRIDE="${pkgver}"

    cmake --build build --parallel
}

package() {
    cd "${srcdir}/${_srcdir}"

    install -Dm755 build/mx-boot-repair "${pkgdir}/usr/bin/mx-boot-repair"
    install -Dm755 build/helper "${pkgdir}/usr/lib/mx-boot-repair/helper"

    # app_init.cpp loads from /usr/share/mx-bootrepair/locale - the repository
    # name, not pkgname. qt6_add_translations() writes the catalogues to build/.
    install -Dm644 -t "${pkgdir}/usr/share/mx-bootrepair/locale/" build/*.qm

    # Generated by configure_file() from scripts/*.policy.in so the helper path
    # in the action matches HELPER_INSTALL_DIR above.
    install -Dm644 build/org.mxlinux.pkexec.mxbr-helper.policy \
        "${pkgdir}/usr/share/polkit-1/actions/org.mxlinux.pkexec.mxbr-helper.policy"

    install -Dm644 mx-boot-repair.desktop "${pkgdir}/usr/share/applications/mx-boot-repair.desktop"

    install -Dm644 icons/mx-boot-repair.png "${pkgdir}/usr/share/icons/hicolor/64x64/apps/mx-boot-repair.png"
    install -Dm644 icons/mx-boot-repair.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/mx-boot-repair.svg"

    # -t, because "install -D" treats its last argument as a file path even
    # with a single source.
    install -Dm644 -t "${pkgdir}/usr/share/man/man1/" man/*.1

    install -dm755 "${pkgdir}/usr/share/doc/mx-bootrepair"
    for help_file in help/*.html; do
        [ -f "$help_file" ] || continue
        install -Dm644 "$help_file" \
            "${pkgdir}/usr/share/doc/mx-bootrepair/$(basename "$help_file")"
    done

    if [ -f debian/changelog ]; then
        gzip -c debian/changelog > "${pkgdir}/usr/share/doc/mx-bootrepair/changelog.gz"
    fi

    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
